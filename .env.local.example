# Copy this file to .env.local for local development, and add the same
# names/values in Vercel → Project → Settings → Environment Variables for
# production. Never commit the real .env.local file.

# --- Supabase (Project Settings → API) ---
# Safe to expose to the browser: the anon key only ever acts under RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Vercel Web Analytics API (used only by the admin dashboard) ---
# Server-side only, never referenced from a NEXT_PUBLIC_ variable or from
# any file imported by a Client Component. Optional: if you skip these, the
# admin Analytics panel just shows "not connected" instead of numbers.
# Create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=
# Project Settings → General → Project ID
VERCEL_PROJECT_ID=
# Only needed if this project lives under a team (not a personal account)
VERCEL_TEAM_ID=
